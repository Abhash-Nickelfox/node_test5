#!/usr/bin/env node
// NFXinit pre-push hook — cross-platform Node.js runner
// Delegates to scripts/prepush.mjs
// Do NOT edit this file directly; edit git-hooks/scripts/prepush.mjs instead.
import { execSync } from 'child_process';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname  = dirname(__filename);
const runner     = join(__dirname, '..', 'scripts', 'prepush.mjs');

// Pass stdin data (remote/url) to the runner
const stdinData = [];
process.stdin.on('data', d => stdinData.push(d));
process.stdin.on('end', () => {
  try {
    execSync(`node "${runner}"`, {
      stdio: 'inherit',
      input: Buffer.concat(stdinData),
    });
  } catch (e) {
    process.exit(1);
  }
});
