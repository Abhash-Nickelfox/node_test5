#!/usr/bin/env node
// NFXinit pre-commit hook — cross-platform Node.js runner
// Delegates to scripts/precommit.mjs
// Do NOT edit this file directly; edit git-hooks/scripts/precommit.mjs instead.
import { execSync } from 'child_process';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname  = dirname(__filename);
const runner     = join(__dirname, '..', 'scripts', 'precommit.mjs');

try {
  execSync(`node "${runner}"`, { stdio: 'inherit' });
} catch (e) {
  process.exit(1);
}
