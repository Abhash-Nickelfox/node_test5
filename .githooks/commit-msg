#!/usr/bin/env node
// NFXinit commit-msg hook — cross-platform Node.js runner
// Delegates to scripts/commitmsg.mjs
// Do NOT edit this file directly; edit git-hooks/scripts/commitmsg.mjs instead.
import { execSync } from 'child_process';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname  = dirname(__filename);
const runner     = join(__dirname, '..', 'scripts', 'commitmsg.mjs');
const msgFile    = process.argv[2] || process.env.GIT_PARAMS || '.git/COMMIT_EDITMSG';

try {
  execSync(`node "${runner}" "${msgFile}"`, { stdio: 'inherit' });
} catch (e) {
  process.exit(1);
}
